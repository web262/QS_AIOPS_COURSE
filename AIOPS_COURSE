    @media (max-width: 640px){
      .wrap{width:min(100% - 24px,1180px)}.brand{padding:8px 10px;gap:10px}.brand img.qv{height:26px}.brand .sep,.brand img.qs{display:none}.hero{padding-top:42px}.mini-stats,.cards,.projects,.faq,.stack-list{grid-template-columns:1fr}.hero-card{min-height:780px}.system-board{inset:0;transform:none}.pipeline{grid-template-columns:repeat(2,1fr)}.screen{grid-template-columns:1fr}.agent-layer,.floating-card{position:relative;width:auto;left:auto;right:auto;bottom:auto;margin-top:14px}.dark-band{padding:28px;border-radius:30px}.flow{grid-template-columns:1fr}.cta-box{padding:28px;border-radius:28px}h1{font-size:38px}
    }
  </style>
