    @media (max-width: 980px){
      .navlinks{display:none}.hero-grid,.curriculum,.agent-section{grid-template-columns:1fr}.hero-card{min-height:620px}.cards,.projects{grid-template-columns:repeat(2,1fr)}.flow{grid-template-columns:repeat(2,1fr)}.section-head{display:block}.section-head p{margin-top:12px}.sticky-note{position:relative;top:0}.modules{grid-template-columns:1fr}.cta-box{display:block}.cta-box .btn{margin-top:20px}
